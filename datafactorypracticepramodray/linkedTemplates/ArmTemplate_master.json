{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactorypracticepramodray"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LinkedDataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LinkedDataLake'"
		},
		"LinkedGit_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LinkedGit'"
		},
		"RestService1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'RestService1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagecontainerdatalake.dfs.core.windows.net/"
		},
		"LinkedDataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagecontainerdatalake.dfs.core.windows.net/"
		},
		"LinkedGit_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"LinkedGit_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"RestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com"
		},
		"RestService1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactorypracticepramodray_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"LinkedDataLake_accountKey": {
						"value": "[parameters('LinkedDataLake_accountKey')]"
					},
					"LinkedGit_password": {
						"value": "[parameters('LinkedGit_password')]"
					},
					"RestService1_password": {
						"value": "[parameters('RestService1_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LinkedDataLake_properties_typeProperties_url": {
						"value": "[parameters('LinkedDataLake_properties_typeProperties_url')]"
					},
					"LinkedGit_properties_typeProperties_url": {
						"value": "[parameters('LinkedGit_properties_typeProperties_url')]"
					},
					"LinkedGit_properties_typeProperties_userName": {
						"value": "[parameters('LinkedGit_properties_typeProperties_userName')]"
					},
					"RestService1_properties_typeProperties_url": {
						"value": "[parameters('RestService1_properties_typeProperties_url')]"
					},
					"RestService1_properties_typeProperties_userName": {
						"value": "[parameters('RestService1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}